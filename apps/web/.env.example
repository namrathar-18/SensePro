# SensePro+ web configuration. Copy to apps/web/.env.local and adjust if needed.
# apps/web/.env.local is gitignored. The values below are safe to commit: the
# Supabase publishable (anon) key ships in the browser and is protected by RLS.
# NEVER put the service-role/secret key here — that is backend-only.

# WebSocket endpoint of the inference backend (laptop webcam -> live recognition)
VITE_WS_URL=ws://localhost:8000/ws/capture

# Supabase project (publishable / anon key ONLY).
VITE_SUPABASE_URL=https://zhyzxunjklscataasamd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Hr3XxXxuGIH_UnMIhG_QUg_K77pB-kU
