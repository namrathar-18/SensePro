# SensePro+ web configuration. Copy to apps/web/.env.local and fill in.
# apps/web/.env.local is gitignored — put real values there, never here.
# NEVER put the service-role/secret key in this app: it is backend-only.

# WebSocket endpoint of the inference backend (laptop webcam -> live recognition)
# 127.0.0.1, not localhost (Windows localhost -> IPv6 breaks the WS to uvicorn).
VITE_WS_URL=ws://127.0.0.1:8000/ws/capture

# Supabase project (publishable / anon key ONLY).
# Find both under Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional one-click demo sign-in on the login page. Leave blank to hide the
# buttons entirely. These accounts can read real student attendance data, so
# these values must never be committed.
VITE_DEMO_TEACHER_PWD=
VITE_DEMO_MANAGEMENT_PWD=
VITE_DEMO_ADMIN_PWD=
