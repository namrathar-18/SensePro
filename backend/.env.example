# SensePro+ Backend Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to git.

# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...   # Settings > API > service_role (secret)
SUPABASE_ANON_KEY=eyJhbGc...     # Settings > API > anon (public)

# ─── JWT (copy from Supabase > Settings > API > JWT Settings > JWT Secret)
JWT_SECRET=your-supabase-jwt-secret

# ─── App tuning (safe defaults — override for calibration)
ARCFACE_THRESHOLD=0.45
FRAME_SAMPLE_RATE=2
MAX_FRAME_WIDTH=640
GRACE_PERIOD_S=90
MISS_PERIOD_S=300
REID_INTERVAL_S=30
VNEI_MIN_STUDENTS=5
VNEI_WINDOW_S=60
GAZE_DOWN_ANGLE_DEG=25.0
GAZE_SUSTAINED_S=5.0

# ─── CORS
CORS_ORIGINS=["http://localhost:5173","https://sensepro.vercel.app"]

# ─── Debug (set false in production)
DEBUG=true
