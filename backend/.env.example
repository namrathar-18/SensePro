# SensePro+ backend configuration. Copy to backend/.env and fill in.
# backend/.env is gitignored — never commit real keys.

# Vision backend: "stub" (dev/CI, no models) or "insightface" (real SCRFD+ArcFace)
VISION_BACKEND=stub

# Presence pipeline tuning
REID_INTERVAL_S=30
MISS_THRESHOLD=3
COSINE_THRESHOLD=0.45
ENROLLMENT_JSON=enrollments.json
# reg_no -> full_name map for the live roster / capture overlay (ships with the
# 4MCA-B class list).
ROSTER_JSON=data/roster.json

# CORS (comma-separated). Defaults to the web dev origin; add the deployed
# frontend origin in production. Never "*".
ALLOW_ORIGINS=http://localhost:5173

# RTSP capture source (Phase 3). The URL embeds the camera credentials — this
# file stays a template; put the real URL only in backend/.env. Logs mask it.
# RTSP_URL=rtsp://admin:PASSWORD@192.168.1.15:554/cam/realmonitor?channel=1&subtype=0
RTSP_URL=
SAMPLE_FPS_LECTURE=2
SAMPLE_FPS_EXAM=5

# Exam-mode proctoring (Phase 3): "stub" (dev/CI) or "yolo" (pretrained
# YOLOv8n; pip install -e '.[proctor]'). Suppression tuning below.
PROCTOR_BACKEND=stub
GAZE_WINDOW_S=10
GAZE_PITCH_DOWN_DEG=-25
PROCTOR_COOLDOWN_S=30

# VNEI engagement (Phase 3): zone aggregates only, k>=5 suppression. Bands
# are fractions of frame height (lower in frame = closer to the camera).
ENGAGEMENT_WINDOW_S=60
ZONE_FRONT_BAND=0.66
ZONE_BACK_BAND=0.33

# Supabase write-path (Phase 2). The URL is not secret; the secret key is.
# Leave SUPABASE_SECRET_KEY blank to run fully offline with a no-op writer
# (attendance still streams live to the browser, it just doesn't persist).
SUPABASE_URL=https://your-project-ref.supabase.co
# The sb_secret_ server key (Supabase > Project Settings > API keys). Bypasses
# RLS — server side ONLY, never in the browser or committed to git. Paste yours
# here in backend/.env (which is gitignored) to enable persistence.
SUPABASE_SECRET_KEY=
